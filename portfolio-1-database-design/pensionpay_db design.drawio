        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nerDiagram\n    EMPLOYERS ||--o{ EMPLOYEES : employs\n    EMPLOYEES ||--|| PENSION_ACCOUNTS : owns\n    PENSION_ACCOUNTS ||--o{ CONTRIBUTIONS : receives\n\n    EMPLOYERS {\n        BIGINT employer_id PK\n        VARCHAR employer_name\n        VARCHAR registration_number UK\n        VARCHAR email\n        VARCHAR phone\n    }\n\n    EMPLOYEES {\n        BIGINT employee_id PK\n        BIGINT employer_id FK\n        VARCHAR first_name\n        VARCHAR last_name\n        VARCHAR email\n        DATE employment_date\n        VARCHAR status\n    }\n\n    PENSION_ACCOUNTS {\n        BIGINT account_id PK\n        BIGINT employee_id FK UK\n        VARCHAR pfa_name\n        VARCHAR rsa_pin UK\n        VARCHAR account_status\n    }\n\n    CONTRIBUTIONS {\n        BIGINT contribution_id PK\n        BIGINT account_id FK\n        DATE contribution_month\n        NUMERIC employee_amount\n        NUMERIC employer_amount\n        NUMERIC total_amount\n        VARCHAR contribution_status\n    }\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="3E_Mzn5V_ToaU_XV-1L2-1">
